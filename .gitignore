# Secrets — never commit these.
.env
*.key
*.env
# Generated media & transient build outputs
projects/*/sections/
projects/*/audio/
projects/*/build/
projects/*/out/
!.gitkeep
.manim019-cache-quarantine/

# Ignore local media renders but preserve curated showcase gallery
/media/*
!/media/showcase/

# Root-level loose media generated during ad-hoc runs or tests
/*.mp4
/*.png
/*.jpg
/*.jpeg
/*.wav
/*.m4a
/*.gif
/*.webm

# Python & test artifacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest_cache_tmp/
.pytest_tmp/
*.log
build/

# Downloadable model weights (fetched by setup scripts, not source)
models/
tools/kokoro/*.onnx
tools/kokoro/*.bin

# OS
.DS_Store
Thumbs.db
self_correction_report.json

