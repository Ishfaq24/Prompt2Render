# Copy to .env and fill in. Real environment variables always win over this
# file, so you can override any of it for a single run.

# --- scene generation -------------------------------------------------------
# Gemini, over its OpenAI-compatible endpoint.
# Never commit real credentials. Copy this file to .env and fill these locally.
GEMINI_API_KEY=

# Optional backup keys. Use keys from separate Google AI Studio / Cloud projects
# when independent quotas are required. The application rotates these safely.
GEMINI_API_KEY_BACKUP_1=
GEMINI_API_KEY_BACKUP_2=
GEMINI_API_KEY_BACKUP_3=

# Optional comma-separated key list. This is combined with the variables above
# and duplicates are removed while preserving order.
# P2R_GEMINI_KEYS=

# Ordered model fallback chain. Verify these model IDs are available in your
# Google AI Studio account before using them. The first model is preferred.
P2R_GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
P2R_SCENE_MODEL=gemini-3.7-flash

# How much model reasoning to request. Keep low for fast code/storyboard output.
P2R_REASONING=low

# A quota-limited key/model route is skipped during this cooldown window.
P2R_MODEL_COOLDOWN_SECONDS=60

# Maximum temporary retries per key/model route. Quota errors do not consume
# this budget; they immediately move to the next route.
P2R_MAX_MODEL_ATTEMPTS=4
P2R_MAX_KEY_ATTEMPTS=1

# Number of sections storyboarded concurrently. Start with 1 or 2 on free-tier
# quotas, then increase only if the provider accepts the request rate.
P2R_SCENE_JOBS=2

# --- voice ------------------------------------------------------------------
# kokoro   local Kokoro-82M via kokoro-onnx. Offline, deterministic, and the
#          only backend that yields sample-exact sentence boundaries.
# edge     Microsoft edge-tts. Online, optional, not the supported path.
# own      your own recordings in <project>/audio/NN.wav
P2R_TTS_BACKEND=kokoro

P2R_KOKORO_VOICE=am_eric
P2R_KOKORO_SPEED=1.0
P2R_KOKORO_DIR=./tools/kokoro
# Set to use the smaller/faster quantised model instead of the default fp32.
# P2R_KOKORO_MODEL=kokoro-v1.0.int8.onnx

# Only read by the edge backend.  List voices:  edge-tts --list-voices
P2R_TTS_VOICE=en-IN-PrabhatNeural
P2R_TTS_RATE=-4%

# Pauses inserted between sentences, in milliseconds. These decide how the
# channel *sounds* — tune them by ear on one section before committing.
P2R_PAUSE_SENTENCE_MS=320
P2R_PAUSE_PARAGRAPH_MS=650

# Programme loudness target. -14 LUFS is YouTube's.
P2R_LUFS=-14

# --- forced alignment -------------------------------------------------------
# Uses the whisper filter compiled into ffmpeg — no Python package needed.
#   python prompt2render.py models --asr base.en
# Either a model name (tiny.en|base.en|small.en) or an explicit path.
P2R_WHISPER_MODEL=base.en

# --- timeline and motion ----------------------------------------------------
# Cut this many ms *before* the word lands. Landing after reads as sloppy.
P2R_VISUAL_LEAD_MS=120
# none | dissolve | dissolve+reveal
P2R_MOTION=dissolve+reveal

# --- parallelism --------------------------------------------------------
# Default concurrency for `prompt2render encode` when --jobs isn't passed. Each
# worker is its own ffmpeg subprocess; 2 is a conservative start on a
# 4-core box (libx264 -preset veryfast already threads per call).
P2R_ENCODE_JOBS=1
# Default concurrency for prompt2render check's caption-drift gate (the slowest one
# -- a separate whisper pass per section). Each worker loads its own copy
# of the ASR model into RAM, so this is capped lower than CPU count by
# default rather than maximised.
P2R_QC_JOBS=3
